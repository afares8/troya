# Cascade CLI Environment Variables
# Copy this file to .env or export these variables in your shell

# Required: Your LLM provider
# Options: openai, anthropic, ollama, groq, custom
CASCADE_PROVIDER=openai

# Required: Your API key
CASCADE_API_KEY=sk-...

# Optional: Override the model
CASCADE_MODEL=gpt-4o

# Optional: Override the API base URL (for custom/Ollama providers)
# CASCADE_API_BASE=http://localhost:11434/v1

# Optional: Max tokens per response
CASCADE_MAX_TOKENS=4096

# Optional: Temperature (0.0 - 2.0)
CASCADE_TEMPERATURE=0.7
